{
  "name": "fix-my-comments",
  "displayName": "Fix My Comments",
  "description": "AI-powered task management and collaboration layer attached directly to source code.",
  "version": "0.0.1",
  "publisher": "fix-my-comments",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "comments",
    "tasks",
    "ai",
    "collaboration",
    "code-review"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "fixMyComments.createTask",
        "title": "Comment",
        "category": "Fix My Comments"
      },
      {
        "command": "fixMyComments.submitComment",
        "title": "Add Comment",
        "category": "Fix My Comments",
        "enablement": "!commentIsEmpty"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "fixMyComments.createTask",
          "when": "editorHasSelection",
          "group": "navigation@9"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "fixMyComments.submitComment",
          "group": "inline",
          "when": "commentController == fixMyComments"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "fixMyComments",
          "title": "Fix My Comments",
          "icon": "resources/fix-my-comments.svg"
        }
      ]
    },
    "views": {
      "fixMyComments": [
        {
          "id": "fixMyComments.tasks",
          "name": "Tasks"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "fixMyComments.tasks",
        "contents": "No tasks yet.\nSelect code in the editor to create your first task."
      }
    ],
    "keybindings": [
      {
        "command": "fixMyComments.submitComment",
        "key": "enter",
        "when": "inCommentEditorInput"
      },
      {
        "command": "lineBreakInsert",
        "key": "shift+enter",
        "when": "inCommentEditorInput"
      }
    ]
  },
  "scripts": {
    "clean": "rimraf dist out",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "check-types": "tsc --noEmit",
    "build": "npm run check-types && node esbuild.js --production",
    "lint": "eslint -c eslint.config.mjs src",
    "gen:types": "npx type-crafter generate typescript-with-decoders types/index.yaml src/generated SingleFile SingleFile && eslint --fix src/generated/ && prettier --write src/generated/",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm run build",
    "prepare": "husky",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.10.2",
    "@types/vscode": "^1.95.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "type-crafter": "^0.13.4",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.61.1"
  },
  "dependencies": {
    "type-decoder": "^2.3.1"
  }
}
